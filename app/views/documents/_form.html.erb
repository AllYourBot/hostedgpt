<%= form_with(model: document, class: "contents") do |form| %>
  <%= render "layouts/form_errors", record: document, title: t("app.documents.form.errors_title", count: document.errors.count) %>

  <%= labeled_text_field form, :user_id, t("app.documents.form.user_id"), value: User.last.id %>

  <%= labeled_text_field form, :assistant_id, t("app.documents.form.assistant_id"), value: Assistant.last.id %>

  <%= labeled_text_field form, :message_id, t("app.documents.form.message_id"), value: Message.last.id %>

  <%= labeled_text_field form, :filename, t("app.documents.fields.filename") %>

  <%= labeled_text_field form, :purpose, t("app.documents.fields.purpose"), value: "assistants" %>

  <div class="my-5">
    <%= form.label :bytes, t("app.documents.fields.bytes") %>
    <%= form.number_field :bytes, class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full" %>
  </div>

  <div class="inline">
    <%= form.submit class: "rounded-lg py-3 px-5 bg-blue-600 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
