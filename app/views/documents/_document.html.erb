<div id="<%= dom_id document %>">
  <% {
    user: document.user_id,
    assistant: document.assistant_id,
    message: document.message_id,
    filename: document.filename,
    purpose: document.purpose,
    bytes: document.bytes
  }.each do |field, value| %>
    <p class="my-5">
      <strong class="block font-medium mb-1"><%= t("app.documents.fields.#{field}") %>:</strong>
      <%= value %>
    </p>
  <% end %>

  <% if action_name != "show" %>
    <%= link_to t("app.documents.show_title"), document, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to t("app.documents.edit"), edit_document_path(document), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
