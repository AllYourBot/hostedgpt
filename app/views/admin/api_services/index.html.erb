<div class="mx-auto w-full">
  <%= render "admin/tabs" %>

  <h1 class="text-3xl mb-5"><%= t("app.admin.api_services.index.title") %></h1>

  <p class="mb-5">
    <%= link_to t("app.admin.api_services.index.add_new"), new_admin_api_service_path,
      class: %|
        inline-block font-bold
        bg-gray-200 dark:bg-gray-900
        border border-gray-400
        rounded-lg py-3 px-5
        cursor-pointer
      |
    %>
  </p>

  <table id="api-services" class="w-full table-auto border-b border-gray-300 dark:border-b-0">
    <thead>
      <tr class="bg-gray-200 dark:bg-gray-900 text-left">
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.owner") %></th>
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.name") %></th>
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.service_type") %></th>
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.driver") %></th>
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.url") %></th>
        <th class="px-2 py-1"><%= t("app.admin.api_services.index.token") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "api_service", collection: @api_services %>
    </tbody>
  </table>
</div>
