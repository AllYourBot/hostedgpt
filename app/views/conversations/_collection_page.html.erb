<%# locals: (title_key:, conversations:, page_context:, empty_role:, empty_key:) %>
<%# One shell for the /pinned, /bookmarks, and /reactions card grids: the three pages
    differ only in title, collection, context, and empty state, so they render this
    with their own tokens instead of copying the frame. %>
<% content_for :nav_column do %>
  <%= render "messages/nav_column" %>
<% end %>

<turbo-frame id="conversation" class="relative flex flex-col flex-1 min-w-0" data-turbo-action="advance">
  <header id="narrow-header" class="flex-none text-lg h-14 md:hidden">
    <div class="flex items-center flex-1 mb-2 border-b border-gray-300 text-gray-950 dark:text-gray-100 dark:border-gray-600 dark:bg-gray-800">
      <%= render "layouts/nav_toggle" %>
    </div>
  </header>

  <div class="px-[2rem] mb-[4rem] mt-4 md:mt-[4rem]">
    <h1 class="text-2xl mb-4 font-semibold tracking-tighter"><%= t(title_key) %></h1>

    <% if conversations.present? %>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <%= render partial: "conversation_card", collection: conversations, as: :conversation, locals: { page_context: page_context } %>
      </div>
    <% else %>
      <p class="mt-6 text-sm text-gray-400 dark:text-gray-500" data-role="<%= empty_role %>">
        <%= t(empty_key) %>
      </p>
    <% end %>
  </div>
</turbo-frame>
