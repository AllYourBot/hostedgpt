<%# locals: (conversation:, settings: true) %>
<% selected = conversation == @conversation %>
<% pinned = conversation.pinned?(Current.user) %>
<% bookmarked = conversation.bookmarked?(Current.user) %>
<%# Drag spans both sections in the main view only: a filtered list shows a subset, and dragging
    a subset would corrupt the saved order of the rest. The drop position decides membership —
    landing in the pinned area pins, landing below unpins. %>
<% sortable = @query.blank? && !@bookmarks_view && !@reactions_view %>

<div
  id="<%= dom_id(conversation) %>"
  class="
    rounded-lg mr-5 cursor-pointer group
    hover:bg-gray-100 dark:hover:bg-gray-700
    relationship:bg-gray-200 dark:relationship:bg-gray-700
    mb-px
    <%= selected && "relationship" %>
  "
  <% if sortable %>
    data-sortable-target="item"
    data-sortable-id="<%= conversation.id %>"
    data-sortable-zone="<%= pinned ? "pinned" : "unpinned" %>"
    data-action="pointerdown->sortable#press"
  <% end %>
  data-role="conversation"
  data-radio-behavior-target="radio"
  data-radio-behavior-also-select-id="<%= conversation.assistant.id %>"
>
  <turbo-frame id="conversation-<%= conversation.id %>" class="flex-1 flex justify-between items-center">
    <%= link_to conversation.title.presence || t("app.conversations.new_chat"),
      conversation_messages_path(conversation),
      class: "flex-1 pl-2 py-2 truncate text-sm text-opacity-1 w-5 radio-behavior",
      draggable: "false", # so dragging the title reorders the row rather than dragging the link
      data: {
        turbo_frame: "conversation",
        action: "radio-behavior#select nav#closeDrawer",
        role: "title"
      }
    %>

    <div class="flex items-center pr-1">
      <%# Pin/bookmark toggles share the save_toggle partial with the card (see partial
          for the _top break-out and morph contract). nav_view + query bounce the
          current view back so the response re-renders the list the user is looking at. %>
      <% nav_view = @bookmarks_view ? "bookmarks" : (@reactions_view ? "reactions" : nil) %>
      <%= render "conversations/save_toggle", conversation: conversation, pinned: pinned, bookmarked: bookmarked, nav_view: nav_view, query: @query %>
      <%# Full picker on the sidebar row: the ghost clone strips Stimulus wiring from its
          scenery copy only, so the row's own controller stays connected through drags and
          morphs like any other row controller. Counts render beside it, same partial as messages. %>
      <%= render "reactions/conversation_picker", conversation: conversation %>
    </div>
    <%# Always laid out (invisible, not hidden): revealing on hover must not reflow the row,
        or the icons shift out from under the cursor and clicks land on the menu instead. %>
    <div class="flex items-center invisible gap-2 pl-2 relationship:visible group-hover:visible">
      <div class="dropdown !inline-flex dropdown-end outline-none pr-2">
        <%= icon "ellipsis-horizontal",
          tabindex: 0,
          role: :button,
          variant: :micro,
          size: 18,
          class: %|
            outline-none cursor-pointer group-hover:visible
            hover:text-gray-600 dark:hover:text-gray-300
            focus:text-gray-600 dark:focus:text-gray-300
          |,
          data: {
            controller: "nested-pointer",
            role: "options"
          },
          title: t("app.conversations.options"),
          tooltip: :top
        %>

        <menu tabindex="0" class="dropdown-content z-10 menu p-2 shadow-xl bg-base-100 rounded-box w-52 mt-7 dark:text-white dark:!bg-gray-700" data-controller="nested-pointer">
          <li>
            <%= link_to edit_conversation_path(conversation),
              data: {
                role: "edit",
              },
              class: "flex gap-2 w-full py-2 px-4" do
            %>
              <%= icon "pencil",
                variant: :outline,
                size: 16,
                title: t("app.conversations.rename"),
                tooltip: :top,
                class: "mx-[1px]"
              %><%= t("app.conversations.rename") %>
            <% end %>
          </li>
          <li>
            <%= button_to conversation_path(conversation),
              method: :delete,
              data: {
                role: "delete",
              },
              form: {
                class: "inline-block p-0",
                data: { turbo_frame: "_top" },
              },
              class: "flex gap-2 w-full py-2 px-4" do
            %>
              <%= icon "trash", variant: :outline, size: 18 %><%= t("app.conversations.delete") %>
            <% end %>
          </li>
          <footer class="py-3 px-4 mt-1 border-t-2 border-gray-100 dark:border-gray-600 gap-2 flex flex-col">
            <table class="w-full text-left">
              <tr>
                <td class="pb-2 font-bold" colspan="2"><%= t("app.conversations.cost_summary.input") %></td>
              </tr>
              <tr>
                <td class="pb-2"><%= t("app.conversations.cost_summary.tokens") %></td>
                <td class="pb-2"><%= conversation.input_token_total_count %></td>
              </tr>
              <tr>
                <td class="pb-2 font-bold" colspan="2"><%= t("app.conversations.cost_summary.output") %></td>
              </tr>
              <tr>
                <td><%= t("app.conversations.cost_summary.tokens") %></td>
                <td><%= conversation.output_token_total_count %></td>
              </tr>
            </table>
          </footer>
        </menu>
      </div>

    </div>
  </turbo-frame>
</div>
