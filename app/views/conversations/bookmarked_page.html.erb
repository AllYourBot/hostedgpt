<% content_for :nav_column do %>
  <%= render "messages/nav_column" %>
<% end %>

<turbo-frame id="conversation" class="relative flex flex-col flex-1 min-w-0" data-turbo-action="advance">
  <header id="narrow-header" class="flex-none text-lg h-14 md:hidden">
    <div class="flex items-center flex-1 mb-2 border-b border-gray-300 text-gray-950 dark:text-gray-100 dark:border-gray-600 dark:bg-gray-800">
      <%= render "layouts/nav_toggle" %>
    </div>
  </header>

  <div class="px-[2rem] mb-[4rem] mt-4 md:mt-[4rem] max-w-3xl">
    <h1 class="text-2xl mb-4 font-semibold tracking-tighter"><%= t("app.conversations.ui.bookmarked_page_title") %></h1>

    <% if @bookmarked_conversations.blank? && @bookmarked_messages.blank? %>
      <p class="mt-6 text-sm text-gray-400 dark:text-gray-500" data-role="empty-bookmarks">
        <%= t("app.conversations.ui.no_bookmarks_yet") %>
      </p>
    <% else %>
      <% [
        [t("app.conversations.ui.bookmarked_conversations"), @bookmarked_conversations, "conversations/bookmarked_conversation_entry"],
        [t("app.conversations.ui.bookmarked_messages"), @bookmarked_messages, "conversations/bookmarked_message_entry"]
      ].each do |title, bookmarks, entry_partial| %>
        <% next if bookmarks.blank? %>
        <h2 class="mt-6 mb-2 text-base font-semibold text-gray-400 dark:text-gray-500"><%= title %></h2>
        <ul class="flex flex-col gap-1">
          <%= render partial: entry_partial, collection: bookmarks, as: :bookmark %>
        </ul>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
