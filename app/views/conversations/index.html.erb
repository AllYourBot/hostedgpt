<turbo-frame id="nav-conversations">
  <section id="search" class="pt-6 text-gray-950 dark:text-gray-100 select-none">
    <%= form_with(url: conversations_path,
      data: { turbo_frame: "nav_conversations", controller: "search" },
      class: "contents",
      method: :get
    ) do |form| %>
      <div class="relative ml-2 mr-5">
        <%# Preserve locale when submitting/clearing the search so the placeholder stays localized %>
        <%= hidden_field_tag :locale, I18n.locale unless I18n.locale == I18n.default_locale %>
        <%= form.text_field :query,
          value: @query,
          placeholder: t("app.conversations.ui.search_placeholder"),
          id: "search-input",
          autofocus: !@query.nil?,
          class: %|
            w-full
            p-2 py-1
            border border-gray-200 rounded-lg
            text-black dark:text-gray-200
            placeholder-gray-300 dark:placeholder-gray-500
            bg-transparent
          |,
          data: {
            search_target: "input",
            action: %|
              blur->search#unfocus
              input->search#search
            |
          }
        %>
        <%= icon "x-circle",
          variant: :mini,
          size: 18,
          class: "cursor-pointer text-gray-800 absolute right-1 top-1/2 transform -translate-y-1/2",
          data: { search_target: "clear", action: "click->search#clear" }
        %>
      </div>
    <% end %>
  </section>

  <section class="text-gray-950 dark:text-gray-100 select-none">
    <turbo-frame id="conversations"
      target="conversation"
      data-controller="radio-behavior sortable"
      data-radio-behavior-selected-class="relationship"
      data-sortable-url-value="<%= reorder_conversations_path %>"
      data-sortable-dragging-class="opacity-0"
      class="block mb-24" <%# ensures the last conversation's menu has room to open %>
    >
      <%= render @nav_conversations %>
    </turbo-frame>
  </section>
</turbo-frame>
