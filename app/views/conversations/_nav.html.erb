  <section id="search" class="pt-6 text-gray-950 dark:text-gray-100 select-none">
    <%= form_with(url: conversations_path,
      data: { turbo_frame: "nav-conversations", controller: "search" },
      class: "contents",
      method: :get
    ) do |form| %>
      <div class="relative ml-2 mr-5">
        <%# Preserve locale when submitting/clearing the search so the placeholder stays localized %>
        <%= hidden_field_tag :locale, I18n.locale unless I18n.locale == I18n.default_locale %>
        <%# Preserve funnel scope so a search narrows within the active filter (R11 + query). %>
        <% if (@show.presence || "all") != "all" %>
          <%= hidden_field_tag :show, @show %>
        <% end %>
        <%= form.text_field :query,
          value: @query,
          placeholder: t("app.conversations.ui.search_placeholder"),
          id: "search-input",
          autofocus: !@query.nil?,
          class: %|
            w-full
            p-2 py-1
            border border-gray-200 rounded-lg
            text-black dark:text-gray-200
            placeholder-gray-300 dark:placeholder-gray-500
            bg-transparent
          |,
          data: {
            search_target: "input",
            action: %|
              blur->search#unfocus
              input->search#search
            |
          }
        %>
        <%= icon "x-circle",
          variant: :mini,
          size: 18,
          class: "cursor-pointer text-gray-800 absolute right-1 top-1/2 transform -translate-y-1/2",
          data: { search_target: "clear", action: "click->search#clear" }
        %>
      </div>
    <% end %>
  </section>

  <%# Funnel minimal slice (R8-R14, KTD6-KTD8): self-announcing filter with a labeled
      button, Show menu (All, Bookmarked, Reacted — no Show-Pinned, the strip covers it),
      suppressed strip in scopes, scoped empty states with one-tap clear, and an aria-live
      announcement. Scope lives in frame params/query and resets on reload (R14). Order is
      always Last-activity-desc; pins carry the only hand order. %>
  <% funnel_show = @show.presence || "all" %>
  <% funnel_active = funnel_show != "all" %>
  <% funnel_query = @query.presence %>
  <section data-role="filter" class="ml-2 mr-5 mt-2 text-gray-950 dark:text-gray-100 select-none">
    <%# The clear X sits beside the dropdown, never inside it: a click inside would match
        :focus-within and pop the menu open over the freshly cleared list. Same one-tap
        semantics as All — drops the Show scope, keeps the query. %>
    <div class="flex items-center">
    <div class="dropdown">
      <div tabindex="0" role="button"
        data-role="filter-button"
        aria-pressed="<%= funnel_active %>"
        aria-haspopup="menu"
        aria-label="<%= t("app.conversations.ui.filter") %><%= funnel_show != "all" ? ": #{t("app.conversations.ui.filter_show_#{funnel_show}")}" : "" %>"
        class="flex items-center mb-1 p-1 pl-2 pr-2 rounded-lg text-sm hover:bg-gray-100 dark:hover:bg-gray-700 <%= "bg-gray-200 dark:bg-gray-700" if funnel_active %>">
        <%= icon "funnel", variant: (funnel_active ? :solid : :outline), size: 16, class: "text-gray-500 dark:text-gray-300" %>
        <% if funnel_show != "all" %>
          <span data-role="filter-label" class="ml-2"><%= t("app.conversations.ui.filter_show_#{funnel_show}") %></span>
        <% end %>
      </div>
      <menu tabindex="0" data-role="filter-menu" aria-label="<%= t("app.conversations.ui.filter") %>"
        class="dropdown-content z-10 menu p-2 shadow-xl bg-base-100 rounded-box w-52 dark:!bg-gray-700">
        <li class="menu-title"><span><%= t("app.conversations.ui.filter_show") %></span></li>
        <li>
          <%= link_to t("app.conversations.ui.filter_show_all"),
            conversations_path(query: funnel_query),
            data: { role: "filter-show-all", turbo_frame: "nav-conversations" },
            aria: ({ current: "true" } if funnel_show == "all") %>
        </li>
        <li>
          <%= link_to t("app.conversations.ui.filter_show_bookmarked"),
            conversations_path(show: "bookmarked", query: funnel_query),
            data: { role: "filter-show-bookmarked", turbo_frame: "nav-conversations" },
            aria: ({ current: "true" } if funnel_show == "bookmarked") %>
        </li>
        <li>
          <%= link_to t("app.conversations.ui.filter_show_reacted"),
            conversations_path(show: "reacted", query: funnel_query),
            data: { role: "filter-show-reacted", turbo_frame: "nav-conversations" },
            aria: ({ current: "true" } if funnel_show == "reacted") %>
        </li>
      </menu>
    </div>
    <% if funnel_active %>
      <%= link_to conversations_path(query: funnel_query),
        data: { role: "filter-clear-button", turbo_frame: "nav-conversations" },
        title: t("app.conversations.ui.filter_clear"),
        aria: { label: t("app.conversations.ui.filter_clear") },
        class: "p-1 mb-1 ml-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700" do %>
        <%= icon "x-mark", variant: :outline, size: 14, class: "text-gray-500 dark:text-gray-300" %>
      <% end %>
    <% end %>
    </div>
    <p class="sr-only" aria-live="polite" data-role="filter-announcement"><%= t("app.conversations.ui.filter_announcement_#{funnel_show}") %></p>
  </section>

  <%# One sortable list spans the pinned and unpinned sections so drops can cross between
      them; rows opt in per-row (main view only), so the controller idles in filtered views. %>
  <section class="text-gray-950 dark:text-gray-100 select-none"
    data-controller="radio-behavior sortable"
    data-radio-behavior-selected-class="relationship"
    data-sortable-url-value="<%= reorder_conversations_path %>"
    data-sortable-pin-prefix-value="/conversations/"
    data-sortable-pin-suffix-value="/pin"
    data-sortable-unpin-prefix-value="/conversations/"
    data-sortable-unpin-suffix-value="/unpin"
    data-sortable-dragging-class="opacity-0"
  >
    <% if @bookmarks_view || @reactions_view %>
      <%= link_to conversations_path,
        data: { role: "all-conversations", turbo_frame: "nav-conversations" },
        class: %|
          flex items-center
          mb-1 p-1 pl-2 pr-2 mr-5
          rounded-lg
          text-sm
          hover:bg-gray-100 dark:hover:bg-gray-700
        | do %>
        <%= icon "chat-bubble-left-ellipsis", variant: :outline, size: 16, class: "text-gray-500 dark:text-gray-300" %>
        <span class="ml-2"><%= t("app.conversations.ui.all_conversations") %></span>
      <% end %>
    <% else %>
      <div class="flex items-center mr-5">
        <%= link_to bookmarks_conversations_path,
          data: { role: "bookmarks-link", turbo_frame: "nav-conversations" },
          class: %|
            flex items-center flex-1
            mb-1 p-1 pl-2 pr-2
            rounded-lg
            text-sm
            hover:bg-gray-100 dark:hover:bg-gray-700
          | do %>
          <%= icon "bookmark", variant: :outline, size: 16, class: "text-gray-500 dark:text-gray-300" %>
          <span class="ml-2"><%= t("app.conversations.ui.bookmarks") %></span>
        <% end %>
        <%# Full-page card grid, not frame-scoped: _top escapes the nav-conversations frame so
            the page navigates instead of swapping the sidebar list. %>
        <%= link_to bookmarked_page_path,
          data: { role: "open-bookmarks-page", turbo_frame: "_top" },
          class: "p-1 mb-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700",
          title: t("app.conversations.ui.open_page") do %>
          <%= icon "arrow-top-right-on-square", variant: :outline, size: 14, class: "text-gray-500 dark:text-gray-300" %>
        <% end %>
      </div>
      <div class="flex items-center mr-5">
        <%= link_to reactions_conversations_path,
          data: { role: "reactions-link", turbo_frame: "nav-conversations" },
          class: %|
            flex items-center flex-1
            mb-1 p-1 pl-2 pr-2
            rounded-lg
            text-sm
            hover:bg-gray-100 dark:hover:bg-gray-700
          | do %>
          <%= icon "face-smile", variant: :outline, size: 16, class: "text-gray-500 dark:text-gray-300" %>
          <span class="ml-2"><%= t("app.conversations.ui.reactions") %></span>
        <% end %>
        <%= link_to reacted_page_path,
          data: { role: "open-reactions-page", turbo_frame: "_top" },
          class: "p-1 mb-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700",
          title: t("app.conversations.ui.open_page") do %>
          <%= icon "arrow-top-right-on-square", variant: :outline, size: 14, class: "text-gray-500 dark:text-gray-300" %>
        <% end %>
      </div>
    <% end %>
    <% if @query.blank? && !@bookmarks_view && !@reactions_view %>
      <% if @pinned_conversations.present? %>
        <header class="mx-2 mt-6 mb-2 mr-5 flex items-center justify-between text-xs font-semibold text-gray-300 text-opacity-1 dark:text-gray-500" data-role="pinned-header">
          <span><%= t("app.conversations.ui.pinned") %></span>
          <%= link_to pinned_page_path,
            data: { role: "open-pinned-page", turbo_frame: "_top" },
            class: "p-1 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700",
            title: t("app.conversations.ui.open_page") do %>
            <%= icon "arrow-top-right-on-square", variant: :outline, size: 14, class: "text-gray-500 dark:text-gray-300" %>
          <% end %>
        </header>
      <% end %>
      <turbo-frame id="pinned-conversations"
        target="conversation"
        data-sortable-zone="pinned"
        class="block"
      >
        <%= render @pinned_conversations %>
      </turbo-frame>
    <% end %>
    <turbo-frame id="conversations"
      target="conversation"
      data-sortable-zone="unpinned"
      class="block mb-24" <%# ensures the last conversation's menu has room to open %>
    >
      <% if @query.blank? && !@bookmarks_view && !@reactions_view %>
        <% Conversation.grouped_by_increasing_time_interval_for_user(Current.user).each do |named_time_span, conversations| %>
          <header class="mx-2 mt-6 mb-2 text-xs font-semibold text-gray-300 text-opacity-1 dark:text-gray-500" data-role="time-group">
            <%= named_time_span %>
          </header>

          <%= render conversations %>
        <% end %>
      <% else %>
        <% if @nav_conversations.present? %>
          <%= render @nav_conversations %>
        <% elsif @bookmarks_view %>
          <p class="mx-2 mt-6 text-sm text-gray-400 dark:text-gray-500" data-role="empty-bookmarks">
            <%= t("app.conversations.ui.no_bookmarks_yet") %>
            <%= link_to t("app.conversations.ui.filter_clear"),
              conversations_path(query: @query.presence),
              data: { role: "filter-clear", turbo_frame: "nav-conversations" },
              class: "underline" %>
          </p>
        <% elsif @reactions_view %>
          <p class="mx-2 mt-6 text-sm text-gray-400 dark:text-gray-500" data-role="empty-reactions">
            <%= t("app.conversations.ui.no_reactions_yet") %>
            <%= link_to t("app.conversations.ui.filter_clear"),
              conversations_path(query: @query.presence),
              data: { role: "filter-clear", turbo_frame: "nav-conversations" },
              class: "underline" %>
          </p>
        <% end %>
      <% end %>
    </turbo-frame>
  </section>
