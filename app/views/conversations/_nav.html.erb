<%# locals: (autofocus: true) %>
<%# The sidebar's inner content, extracted so toggle and search responses can re-render it
    in place as a turbo-stream update of the nav-conversations frame: index.html.erb
    supplies only the surrounding turbo-frame. %>
<%# The single retrieval surface for bookmarks sits above the search (R9), navigating away
    to the full page rather than filtering in place. %>
<div class="flex items-center mr-5 pt-6">
  <%= link_to bookmarked_page_path,
    data: { role: "open-bookmarks-page", turbo_frame: "_top" },
    class: "flex items-center flex-1 py-1 px-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700" do %>
    <%= icon "bookmark", variant: :outline, size: 16, class: "text-gray-500 dark:text-gray-300" %>
    <span class="ml-2 font-semibold"><%= t("app.conversations.ui.bookmarks_page") %></span>
  <% end %>
</div>

<section id="search" class="pt-6 text-gray-950 dark:text-gray-100 select-none">
  <%= form_with(url: conversations_path,
    data: { turbo_frame: "nav-conversations", controller: "search" },
    class: "contents",
    method: :get
  ) do |form| %>
    <div class="relative ml-2 mr-5">
      <%# Preserve locale when submitting/clearing the search so the placeholder stays localized %>
      <%= hidden_field_tag :locale, I18n.locale unless I18n.locale == I18n.default_locale %>
      <%= form.text_field :query,
        value: @query,
        placeholder: t("app.conversations.ui.search_placeholder"),
        id: "search-input",
        autofocus: autofocus && !@query.nil?,
        class: %|
          w-full
          p-2 py-1
          border border-gray-200 rounded-lg
          text-black dark:text-gray-200
          placeholder-gray-300 dark:placeholder-gray-500
          bg-transparent
        |,
        data: {
          search_target: "input",
          action: %|
            blur->search#unfocus
            input->search#search
          |
        }
      %>
      <%= icon "x-circle",
        variant: :mini,
        size: 18,
        class: "cursor-pointer text-gray-800 absolute right-1 top-1/2 transform -translate-y-1/2",
        data: { search_target: "clear", action: "click->search#clear" }
      %>
    </div>
  <% end %>
</section>

<section class="text-gray-950 dark:text-gray-100 select-none">
  <turbo-frame id="conversations"
    target="conversation"
    data-controller="radio-behavior"
    data-radio-behavior-selected-class="relationship"
    class="block mb-24" <%# ensures the last conversation's menu has room to open %>
  >
    <% if @pinned_conversations.any? %>
      <header data-role="pinned-header" class="mx-2 mt-6 mb-2 text-xs font-semibold text-gray-300 text-opacity-1 dark:text-gray-500">
        <%= t("app.conversations.pinned") %>
      </header>

      <div
        data-controller="sortable"
        data-sortable-url-value="<%= reorder_conversations_path %>"
        data-sortable-dragging-class="opacity-0"
        data-action="dragover->sortable#over drop->sortable#drop"
      >
        <%= render partial: "conversations/conversation", collection: @pinned_conversations, locals: { sortable: true } %>
      </div>
    <% end %>

    <% @nav_conversations.each do |named_time_span, conversations| %>
      <header class="mx-2 mt-6 mb-2 text-xs font-semibold text-gray-300 text-opacity-1 dark:text-gray-500">
        <%= translated_time_span(named_time_span) %>
      </header>

      <%= render conversations %>
    <% end %>
  </turbo-frame>
</section>
