<div id="<%= dom_id(assistant, :card) %>" class="relative flex items-start space-x-3 rounded-lg border border-gray-300 bg-white px-6 py-5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-500 focus-within:ring-offset-2 hover:border-gray-400">
  <div class="w-7">
    <%= render partial: "layouts/assistant_avatar", locals: { assistant:, size: 7, classes: "border-none" } %>
  </div>
  <div class="min-w-0 flex-1">
    <%= link_to new_assistant_message_path(assistant), data: { role: "name" } do %>
      <span class="absolute inset-0" aria-hidden="true"></span>
      <p class="flex items-center text-sm font-medium text-gray-900">
        <span class="truncate"><%= assistant.name %></span>
        <% if assistant.context_documents.any? %>
          <% context_files = t("app.assistants.ui.context_files") %>
          <span class="ml-1.5 flex-shrink-0 text-gray-500" role="img" aria-label="<%= context_files %>" title="<%= context_files %>" data-role="context-files">
            <%= icon "paper-clip", variant: :micro %>
          </span>
        <% end %>
      </p>
      <p class="text-sm text-gray-500"><%= assistant.description %> (<%= assistant.language_model_api_name %>)</p>
    <% end %>
  </div>
</div>
