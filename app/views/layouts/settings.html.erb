<% content_for :title, "#{t("app.settings.title")} — #{Setting.product_name}" %>
<% content_for :nav_column do %>
  <header class="pl-2 py-7 text-3xl relative">
    <%= link_to root_path, class: "inline-block cursor-pointer py-1 pt-0 align-middle" do %>
      <%= icon "chevron-left",
        variant: :outline,
        size: 22,
        class: %|
          stroke-2
          text-zinc-600 group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-white
        |,
        title: t("app.settings.home"),
        tooltip: :bottom
      %>
    <% end %>
    <%= t("app.settings.title") %>
  </header>

  <section id="menu" data-controller="radio-behavior" data-radio-behavior-selected-class="relationship">
    <% @settings_menu.each do |controller, settings_items| %>
      <div class="mb-5">
        <%= render partial: "layouts/settings_item", collection: settings_items, locals: { controller: controller } %>
      </div>
    <% end %>
  </section>
<% end %>

<% content_for :main do %>
  <div class="flex flex-col flex-1 min-w-0">
    <header id="narrow-header" class="flex-none text-lg h-14 md:hidden">
      <div class="flex items-center justify-between h-14 mb-2 border-b border-gray-300 text-gray-950 dark:text-gray-100 dark:border-gray-600 dark:bg-gray-800">
        <%= render "layouts/nav_toggle" %>

        <span class="truncate"><%= t("app.settings.title") %></span>

        <%= link_to root_path, class: "block cursor-pointer inline-flex mr-1 px-2 py-2 group" do %>
          <%= icon "x-mark",
            variant: :outline,
            size: 22,
            class: %|
              stroke-2
              text-zinc-600 group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-white
            |,
            title: t("app.settings.close")
          %>
        <% end %>
      </div>
    </header>

    <header class="hidden md:block absolute right-0 ml-2 mt-2 mb-3 h-10 text-lg">
      <%= link_to root_path,
        data: {
          controller: "keyboard",
          action: "keydown.esc@document->keyboard#click"
        },
        class: %|
          block cursor-pointer inline-flex mr-3 px-2 py-2 group
        | do %>
        <%= icon "x-mark",
          variant: :outline,
          size: 22,
          class: %|
            stroke-2
            text-zinc-600 group-hover:text-zinc-900 dark:text-zinc-400 dark:group-hover:text-white
          |,
          title: t("app.settings.close"),
          tooltip: :left
        %>
      <% end %>
    </header>

    <section class="flex flex-col flex-grow overflow-y-auto overflow-x-clip">
      <div class="w-full md:max-w-none lg:max-w-[700px] xl:max-w-[810px] mx-auto mt-2 py-7 px-5 md:px-10 md:pr-14">
        <%= yield %>
      </div>
    </section>
  </div>
<% end %>

<%= render template: "layouts/application" %>
