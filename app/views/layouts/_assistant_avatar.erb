<%# locals: (assistant:, size:, classes: nil) -%>
<% initials_font_size = assistant.initials.to_s.length > 1 ? "text-[10px] tracking-tighter" : (size > 6 ? "text-sm" : "text-xs") %>
<% classes = %|
    rounded-full
    w-#{size} h-#{size}
    #{classes}
|%>
<% logo = if assistant.name.starts_with?("GPT-")
  "openai_logo.svg"
elsif assistant.name.starts_with?("Claude")
  "claude_logo.svg"
elsif assistant.name.starts_with?("Meta Llama")
  "meta_ai_logo.svg"
elsif assistant.name.starts_with?("Gemini")
  "google_gemini_logo.svg"
end
%>
<% if logo %>
  <picture class="<%= classes %> bg-white border border-gray-100 overflow-hidden flex-shrink-0">
    <%= image_tag(logo, class: "w-full h-full") %>
  </picture>
<% else %>
  <picture
    class="
          <%= classes %> <%= initials_font_size %>
          bg-blue-200 text-black
          flex justify-center items-center overflow-hidden flex-shrink-0
          "
  >
    <%= assistant.initials %>
  </picture>
<% end %>
