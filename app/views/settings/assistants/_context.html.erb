<div class="my-5" id="context">
  <h2 class="font-medium"><%= t("app.settings.assistants.context.title") %></h2>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("app.settings.assistants.context.hint") %></p>

  <% if assistant.documents.any? %>
    <ul class="mt-3 divide-y divide-gray-200 dark:divide-gray-700 border border-gray-200 dark:border-gray-700 rounded-md">
      <% assistant.documents.order(:created_at).each do |document| %>
        <li class="flex items-center justify-between px-3 py-2" id="<%= dom_id(document) %>">
          <span class="truncate">
            <%= document.filename %>
            <span class="text-xs text-gray-500 dark:text-gray-400 ml-2"><%= number_to_human_size(document.bytes) %></span>
          </span>
          <%= button_to t("app.settings.assistants.context.remove"),
            settings_assistant_document_path(assistant, document),
            method: :delete,
            data: { turbo_confirm: t("app.settings.assistants.context.confirm_remove") },
            form: { class: "inline-block" },
            class: "text-sm text-red-600 dark:text-red-400 cursor-pointer" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400"><%= t("app.settings.assistants.context.none") %></p>
  <% end %>

  <%= form_with(model: [:settings, assistant, Document.new], class: "mt-3", data: { controller: "form" }) do |form| %>
    <%= form.label :file, t("app.settings.assistants.context.upload"),
      class: %|
        inline-block font-medium text-sm
        bg-gray-100 dark:bg-gray-900
        border border-gray-400
        rounded-lg py-2 px-4
        cursor-pointer
      | %>
    <%= form.file_field :file, class: "hidden", data: { action: "change->form#submit" } %>
  <% end %>
</div>
