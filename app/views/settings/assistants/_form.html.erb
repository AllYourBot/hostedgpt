<%= form_with(model: [:settings, assistant], class: "contents") do |form| %>
  <%= render "layouts/form_errors", record: assistant, title: t("app.settings.assistants.form.errors_title", count: assistant.errors.count) %>

  <%= labeled_text_field form, :name, t("app.settings.assistants.form.name"), autofocus: assistant.new_record? %>

  <% unless assistant.new_record? %>
    <%= labeled_text_field form, :slug, t("app.settings.assistants.form.slug") %>
  <% end %>

  <div class="my-5">
    <%= form.label :language_model_id, t("app.settings.assistants.form.language_model") %><br/>
    <%= form.select :language_model_id,
      @models,
      {},
      class: %|
        block
        border border-gray-200 outline-none
        shadow rounded-md
        px-3 py-2 mt-2
        w-full
        dark:text-black
      | %>
  </div>

  <%= labeled_text_field form, :description, t("app.settings.assistants.form.description") %>

  <div class="my-5">
    <%= form.label :instructions, t("app.settings.assistants.form.instructions") %>
    <%= form.text_area :instructions,
      autofocus: assistant.persisted?,
      class: %|
        block w-full
        border border-gray-200 outline-none
        shadow rounded-md
        px-3 py-2 mt-2
        dark:text-black
        h-18
        overflow-y-auto
      |,
      data: {
        controller: "textarea-autogrow",
        action: %|
          keydown.meta+enter->textarea-autogrow#submitForm
          keydown.ctrl+enter->textarea-autogrow#submitForm
        |
      }
    %>
  </div>

  <fieldset class="my-5">
    <legend><%= t("app.settings.assistants.form.conversation_starters") %></legend>
    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("app.settings.assistants.form.conversation_starters_hint", count: Assistant::MAX_CONVERSATION_STARTERS) %></p>

    <% Assistant::MAX_CONVERSATION_STARTERS.times do |index| %>
      <% id = "assistant_conversation_starters_#{index}" %>
      <%= form.label :conversation_starters, t("app.settings.assistants.form.conversation_starter", number: index + 1), for: id, class: "sr-only" %>
      <%= form.text_field :conversation_starters,
        multiple: true,
        value: assistant.conversation_starters[index],
        id:,
        class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full dark:text-black" %>
    <% end %>
  </fieldset>

  <%= form.submit t("app.settings.assistants.form.save"),
    class: %|
      inline-block font-bold
      bg-gray-200 dark:bg-gray-900
      border border-gray-400
      rounded-lg py-3 px-5
      cursor-pointer
    |,
    data: { turbo_submits_with: t("app.settings.assistants.form.saving") }
  %>
<% end %>
