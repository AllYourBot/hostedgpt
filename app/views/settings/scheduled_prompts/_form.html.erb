<%= form_with(model: [:settings, scheduled_prompt], class: "contents") do |form| %>
  <%= render "layouts/form_errors", record: scheduled_prompt, title: t("app.settings.scheduled_prompts.form.errors_title", count: scheduled_prompt.errors.count) %>

  <% if scheduled_prompt.paused_for_failures? %>
    <p id="paused-for-failures" class="my-5 p-3 rounded-md bg-amber-100 text-amber-900 dark:bg-amber-900 dark:text-amber-100">
      <%= t("app.settings.scheduled_prompts.form.paused_for_failures", count: scheduled_prompt.consecutive_failures) %>
      <% if (latest = scheduled_prompt.conversations.order(:created_at).last) %>
        <%= link_to t("app.settings.scheduled_prompts.form.see_latest_run"), conversation_messages_path(latest), class: "underline" %>
      <% end %>
    </p>
  <% end %>

  <%= labeled_select form, :assistant_id, t("app.settings.scheduled_prompts.form.assistant"),
    Current.user.assistants.ordered.map { [it.name, it.id] } %>

  <div class="my-5">
    <%= form.label :prompt, t("app.settings.scheduled_prompts.form.prompt") %>
    <%= form.text_area :prompt,
      rows: 4,
      placeholder: t("app.settings.scheduled_prompts.form.prompt_placeholder"),
      class: %|
        block w-full
        border border-gray-200 outline-none
        shadow rounded-md
        px-3 py-2 mt-2
        dark:text-black
      |
    %>
  </div>

  <%= labeled_text_field form, :schedule, t("app.settings.scheduled_prompts.form.schedule"),
    placeholder: t("app.settings.scheduled_prompts.form.schedule_placeholder") %>
  <p class="-mt-3 text-sm text-gray-600 dark:text-gray-400"><%= t("app.settings.scheduled_prompts.form.schedule_hint") %></p>

  <div class="my-5">
    <%= form.label :time_zone, t("app.settings.scheduled_prompts.form.time_zone") %>
    <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.us_zones, {},
      class: "block shadow rounded-md border border-gray-200 outline-none px-3 py-2 mt-2 w-full dark:text-black" %>
  </div>

  <div class="my-5">
    <%= form.check_box :enabled %>
    <%= form.label :enabled, t("app.settings.scheduled_prompts.form.enabled") %>
  </div>

  <%= form.submit t("app.settings.scheduled_prompts.save"),
    class: %|
      inline-block font-bold
      bg-gray-200 dark:bg-gray-900
      border border-gray-400
      rounded-lg py-3 px-5
      cursor-pointer
    |
  %>
<% end %>
