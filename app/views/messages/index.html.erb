<% content_for :nav_column do %>
  <%= render "nav_column" %>
<% end %>

<% content_for :messages do %>
  <%# Opening a conversation from the sidebar only swaps this frame, so the sidebar's dot is removed from here. %>
  <%= turbo_stream.remove "#{dom_id(@conversation)}-unread" if @marked_read %>

  <%= turbo_stream_from @conversation,
    data: {
      controller: "stream-reconnect",
      action: "turbo:before-morph-attribute->stream-reconnect#keepConnectedAttribute"
    }
  %>

  <div
    class="min-w-full"
    data-controller="keyboard"
    data-action="
      keydown.meta+shift+c@document->keyboard#click:prevent
      keydown.ctrl+shift+c@document->keyboard#click:prevent
    "
  >
    <%= render @messages %>
  </div>

<% end %>

<%= render "main_column" %>
