<%# The icon-only /bookmarks entry point for pages with no conversation toggle. Navigates
    to the /bookmarks page, breaking out of any enclosing turbo-frame. %>
<%= link_to bookmarked_page_path,
  class: "block cursor-pointer inline-flex px-2 py-2 group rounded-xl hover:bg-gray-50 dark:hover:bg-gray-700",
  data: { role: "open-bookmarks-page", turbo_frame: "_top" } do %>
  <%= icon "bookmark", variant: :outline, size: 20, class: "text-gray-950 dark:text-gray-100", title: t("app.conversations.ui.bookmarks_page"), tooltip: :left %>
<% end %>
