<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t("app.messages.editing_title") %></h1>

  <turbo-frame id="message-text-<%= @message.id %>">
    <%= form_with(
      model: [@assistant, @new_message],
      class: "content-text",
      data: {
        turbo_frame: "_top",
        controller: "inline-edit"
    }) do |form| %>
      <%= form.hidden_field :conversation_id, value: @message.conversation_id %>
      <%= form.hidden_field :index, value: @message.index %>
      <%= form.hidden_field :branched, value: true %>
      <%= form.hidden_field :branched_from_version, value: @message.version %>

      <%= form.text_area :content_text,
        id: "edit-message-#{@message.id}",
        value: @message.content_text,
        required: true,
        autofocus: true,
        class: %|
          prose
          w-full p-0 m-0
          border-0 focus:ring-0
          bg-transparent
          text-black dark:text-gray-200
          leading-normal
          resize-none
        |,
        rows: 1,
        data: {
          inline_edit_target: "input",
          controller: "textarea-autogrow keyboard",
          action: %|
            keydown.meta+enter->keyboard#submit
          %|
        }
      %>

      <div class="flex flex-wrap justify-center items-center gap-y-2 text-sm font-medium">
        <%= form.submit t("app.messages.form.save_and_submit"),
          data: {
            role: "save",
            turbo_submits_with: t("app.messages.form.saving")
          },
          class: %|
            inline-block cursor-pointer
            rounded-lg py-2 px-3
            bg-gray-200 dark:bg-gray-900
            border border-gray-400
          | %>
        <%# Changes this message where it stands: no new version, no new reply, and the replies below it are kept.
            The form's hidden branching fields are for Save & Submit, so update ignores them. %>
        <%= form.button t("app.messages.form.save_in_place"),
          formaction: message_path(@message, version: @version),
          formmethod: :patch,
          title: t("app.messages.form.save_in_place_hint"),
          data: {
            role: "save-in-place",
            turbo_submits_with: t("app.messages.form.saving")
          },
          class: %|
            inline-block cursor-pointer
            ml-3 rounded-lg py-2 px-3
            bg-gray-200 dark:bg-gray-900
            border border-gray-400
          | %>
        <%= link_to t("app.messages.form.cancel"), message_path(@message, version: @version),
          data: {
            controller: "keyboard",
            action: "keydown.esc@document->keyboard#click",
            role: "cancel"
          },
          class: "inline-block ml-5"
        %>
      </div>
    <% end %>
  </turbo-frame>

  <%= link_to t("app.messages.form.show"), @message, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
</div>
