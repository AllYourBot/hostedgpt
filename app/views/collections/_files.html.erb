<div class="my-5" id="files">
  <h2 class="font-medium"><%= t("app.collections.files.title") %></h2>
  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1"><%= t("app.collections.files.hint") %></p>

  <% if collection.documents.any? %>
    <ul class="mt-3 divide-y divide-gray-200 dark:divide-gray-700 border border-gray-200 dark:border-gray-700 rounded-md">
      <% collection.documents.order(:created_at).each do |document| %>
        <li class="flex items-center justify-between px-3 py-2" id="<%= dom_id(document) %>">
          <span class="truncate">
            <%= document.filename %>
            <span class="text-xs text-gray-500 dark:text-gray-400 ml-2"><%= number_to_human_size(document.bytes) %></span>
          </span>
          <%= button_to t("app.collections.files.remove"),
            collection_document_path(collection, document),
            method: :delete,
            data: { turbo_confirm: t("app.collections.files.confirm_remove") },
            form: { class: "inline-block" },
            class: "text-sm text-red-600 dark:text-red-400 cursor-pointer" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-3 text-sm text-gray-500 dark:text-gray-400"><%= t("app.collections.files.none") %></p>
  <% end %>

  <%= form_with(model: [collection, Document.new], class: "mt-3", data: { controller: "form" }) do |form| %>
    <%= form.label :file, t("app.collections.files.upload"),
      class: %|
        inline-block font-medium text-sm
        bg-gray-100 dark:bg-gray-900
        border border-gray-400
        rounded-lg py-2 px-4
        cursor-pointer
      | %>
    <%= form.file_field :file, class: "hidden", data: { action: "change->form#submit" } %>
  <% end %>
</div>
