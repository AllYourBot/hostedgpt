<%= render layout: "page" do %>
  <div class="w-full">
    <h1 class="text-3xl"><%= t("app.collections.edit_title") %></h1>

    <div class="lg:grid lg:grid-cols-2 lg:gap-8">
      <div>
        <%= render "form", collection: @collection %>

        <%= button_to t("app.collections.delete"),
            collection_path(@collection),
            method: :delete,
            data: { turbo_confirm: t("app.collections.confirm_delete") },
            form: { class: "inline-block" },
            class: %|
              ml-5 py-3 px-5
              bg-white dark:bg-gray-500
              border border-gray-300 dark:border-gray-500
              rounded-lg
              font-medium
            |
        %>

        <%= link_to t("app.collections.cancel"), collections_path, class: "float-right inline-block ml-5 py-3" %>
      </div>

      <%= render "files", collection: @collection %>
    </div>
  </div>
<% end %>
